{
  "name": "@lapismd/lapis-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:cargo": "node scripts/managed-cargo.mjs",
    "spec:validate": "spec-validator validate",
    "spec:first": "spec-validator first",
    "spec:build": "spec-validator build",
    "spec:check": "spec-validator check",
    "spec:search": "spec-validator search",
    "check:architecture": "node scripts/architecture.mjs",
    "check:boundaries": "node scripts/boundaries.mjs",
    "check:progress": "node scripts/progress.mjs",
    "format": "prettier --write . && pnpm dev:cargo -- fmt --all",
    "format:check": "prettier --check . && pnpm dev:cargo -- fmt --all -- --check",
    "test:rust": "pnpm dev:cargo -- test --workspace --locked",
    "build:js": "pnpm --filter @lapismd/terminal build",
    "check:js": "pnpm --filter @lapismd/terminal check && pnpm --filter @lapismd/terminal-demo check",
    "test:js": "pnpm --filter @lapismd/terminal test",
    "storybook": "storybook dev --host 127.0.0.1 --port 6048 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "test:storybook": "PLAYWRIGHT_BROWSERS_PATH=.local/browsers vitest run --config catalog/vitest.config.ts",
    "demo:build": "pnpm --filter @lapismd/terminal-demo build",
    "demo:dev": "pnpm build:js && node scripts/demo.mjs dev",
    "check": "pnpm spec:validate && pnpm check:architecture && pnpm check:boundaries && pnpm check:progress && pnpm format:check && pnpm check:js && pnpm dev:cargo -- clippy --workspace --all-targets --locked -- -D warnings",
    "test": "pnpm test:js && pnpm test:rust && pnpm test:storybook",
    "build": "pnpm build:js && pnpm demo:build && pnpm build-storybook && pnpm dev:cargo -- build --workspace --locked",
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=.local/browsers playwright install chromium",
    "test:native": "pnpm build:js && pnpm demo:build && pnpm dev:cargo -- build -p lapis-terminal-demo --features native-smoke --locked && node scripts/native-smoke.mjs",
    "package:check": "pnpm --filter @lapismd/terminal package:check && node scripts/package-check.mjs"
  },
  "devDependencies": {
    "@lapismd/spec-validator": "^0.1.4",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.5.2",
    "typescript": "^5.9.3",
    "tsx": "^4.23.15",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "vite": "^8.3.1",
    "@tauri-apps/api": "^2.11.1",
    "storybook": "10.5.7",
    "@storybook/svelte-vite": "10.5.7",
    "@storybook/addon-svelte-csf": "5.1.2",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-vitest": "10.5.7",
    "@vitest/browser-playwright": "^4.1.11",
    "vitest": "^4.1.11",
    "@playwright/test": "^1.63.0",
    "@axe-core/playwright": "^4.13.0",
    "@sveltejs/package": "^2.5.7",
    "publint": "^0.3.12",
    "@tauri-apps/cli": "^2.11.2",
    "@storybook/svelte": "10.5.7",
    "@lapismd/terminal": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@lapismd/design-core": "^0.5.0"
  }
}
