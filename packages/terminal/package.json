{
  "name": "@lapismd/terminal",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Composable terminal viewport, session client and Tauri transport",
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE.md",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./tauri": {
      "types": "./dist/tauri/index.d.ts",
      "default": "./dist/tauri/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "@tauri-apps/api": "^2.11.1"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    },
    "@tauri-apps/api": {
      "optional": true
    }
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig tsconfig.json --fail-on-warnings",
    "test": "tsx --test tests/*.test.ts",
    "package:check": "publint"
  }
}
